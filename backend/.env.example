# Copy to .env and fill in real values. Never commit the real .env.

# Database (required)
MONGO_URL=mongodb://localhost:27017
DB_NAME=nba_insights_pro

# balldontlie.io (required for live games/scores/team stats)
# Key from https://app.balldontlie.io/ - sent raw in the Authorization header (no "Bearer ").
NBA_API_KEY=

# GPT game analysis / AI articles (required for the Articles feed)
EMERGENT_LLM_KEY=

# Odds (optional)
ODDS_API_KEY=

# Admin emails, comma-separated (optional)
ADMIN_EMAILS=

# Allowed CORS origins, comma-separated (recommended for prod)
CORS_ORIGINS=
